# core-engine demo -> render: the project the engine writes, it must read and render (2026-11-16 regression).
# L10 (2026-11-18): the demo is rebuilt on generated audio, so the render must actually sound (peak > 0),
# not the silence-by-construction the old builtin demo produced.
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${ENGINE}" demo 145 OUTPUT_FILE "${WORK}/demo.json" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "core-engine demo exited with ${rc}")
endif()
file(REMOVE "${WORK}/demo.wav")
execute_process(COMMAND "${ENGINE}" render "${WORK}/demo.json" "${WORK}/demo.wav" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "core-engine render exited with ${rc}: ${err}${out}")
endif()
string(JSON ok GET "${out}" ok)
if(NOT ok)
  message(FATAL_ERROR "render without ok: ${out}")
endif()
if(NOT EXISTS "${WORK}/demo.wav")
  message(FATAL_ERROR "render did not write ${WORK}/demo.wav")
endif()
file(SIZE "${WORK}/demo.wav" size)
if(size LESS 1000000)
  message(FATAL_ERROR "demo.wav has ${size} bytes: expected ~4 MB (13.2 s + tail, 48 kHz, stereo, 24 bits)")
endif()
# The amplitude gate: a render that should sound is non-silent. The old builtin demo rendered peak 0.
string(JSON peak GET "${out}" result peak)
if(peak LESS_EQUAL 0)
  message(FATAL_ERROR "the demo render is silent (peak ${peak}): it must sound from generated audio (L10)")
endif()
message(STATUS "demo.wav ${size} bytes, peak ${peak}")