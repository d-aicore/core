# core-engine measure (offline): every render finite and the block size never changes the sound.
# L10 (2026-11-18): the demo is rebuilt on generated audio, so the sweep must sound (maxPeak > 0). The demo
# has no note-ons now; grid-scheduling accuracy is guarded by engine_tests ("note-ons land on the exact grid").
file(MAKE_DIRECTORY "${WORK}/measure")
execute_process(COMMAND "${ENGINE}" measure --out "${WORK}/measure" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "core-engine measure exited with ${rc}: ${err}")
endif()
string(JSON finite GET "${out}" sweep summary allFinite)
if(NOT finite)
  message(FATAL_ERROR "measure: allFinite = ${finite}")
endif()
# The amplitude gate: the demo sweep really sounds (the old builtin demo rendered peak 0).
string(JSON peak GET "${out}" sweep summary maxPeak)
if(peak LESS_EQUAL 0)
  message(FATAL_ERROR "measure: the demo sweep is silent (maxPeak ${peak}): it must sound from generated audio (L10)")
endif()
# Notes start on the exact (fractional) grid position, rounded once: never a whole sample late.
string(JSON sched GET "${out}" sweep summary maxScheduleErrorSamples)
if(sched GREATER_EQUAL 1)
  message(FATAL_ERROR "measure: maxScheduleErrorSamples ${sched} (expected < 1)")
endif()
string(JSON n LENGTH "${out}" blockIndependence)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  string(JSON d GET "${out}" blockIndependence ${i} maxDifference)
  string(JSON b GET "${out}" blockIndependence ${i} block)
  if(NOT d EQUAL 0)
    message(FATAL_ERROR "measure: block ${b} changes the sound (maxDifference ${d})")
  endif()
endforeach()
message(STATUS "measure: allFinite, maxPeak ${peak}, schedule ${sched} samples, ${n} blocks without difference")