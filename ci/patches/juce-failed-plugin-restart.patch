     SpinLock processMutex;
 
+    // [Core vendored patch - D restart deadlock] True once the host has marked this instance crashed.
+    // The SEH catch leaves processMutex held; the internal restart path must skip this instance instead
+    // of spinning on that lock forever on the message thread. A healthy instance never sets this.
+    std::atomic<bool> hostCrashed { false };
+
+    // [Core vendored patch - D restart deadlock] Acquire processMutex for a control-path call (reset,
+    // releaseResources, updateMidiMappings) without deadlocking on a crashed instance. The host's SEH catch
+    // leaves processMutex held forever, and the host may mark the crash AFTER the call was dispatched (the
+    // plugin asks to restart, then crashes in the same frame), so a blocking enter would spin forever on the
+    // message thread. Retry tryEnter until acquired or the host marks it crashed. A healthy instance never sets
+    // hostCrashed and acquires as soon as processBlock releases the lock — the same outcome as a blocking enter
+    // (the audio hot path and the lock type are untouched). Returns false only for a crashed instance.
+    bool enterProcessMutexUnlessCrashed() noexcept
+    {
+        while (! processMutex.tryEnter())
+        {
+            if (hostCrashed.load (std::memory_order_acquire))
+                return false;
+            Thread::yield();
+        }
+        return true;
+    }
+
+    // [Core vendored patch - D crash-reset deadlock] Acquire processMutex on the audio path
+    // (processBlock / processBlockBypassed) without spinning forever on a lock that a crashed reset()
+    // left held. While stopped the audio thread still renders tails, so it can be waiting on this lock
+    // when reset() crashes under the host's SEH catch, which runs no C++ destructors (/EHsc) and leaves
+    // the lock held forever; the plain blocking enter then froze the audio thread, the engine never
+    // exited and the client terminated it. The fast path is SpinLock::enter()'s own: one successful
+    // tryEnter, no hostCrashed read — an uncontended (healthy) acquire costs exactly the same. Only
+    // when the lock is held does it consult hostCrashed, mirroring enter()'s bounded spin then yield,
+    // and gives up the moment the host marks the crash. Returns false only for a crashed instance.
+    bool enterProcessMutexForAudio() noexcept
+    {
+        if (processMutex.tryEnter())
+            return true;
+
+        for (int i = 20; --i >= 0;)
+        {
+            if (hostCrashed.load (std::memory_order_acquire))
+                return false;
+            if (processMutex.tryEnter())
+                return true;
+        }
+
+        while (! processMutex.tryEnter())
+        {
+            if (hostCrashed.load (std::memory_order_acquire))
+                return false;
+            Thread::yield();
+        }
+        return true;
+    }
+
+    // [Core vendored patch - D crash-reset deadlock] RAII acquire for the audio path: releases on normal
+    // return and on a C++ exception unwind exactly like SpinLock::ScopedLockType, and skips the release
+    // when the lock was not acquired (a crashed instance). Healthy: same lock, same scope, same release.
+    struct ScopedProcessLockUnlessCrashed
+    {
+        explicit ScopedProcessLockUnlessCrashed (VST3PluginInstanceHeadless& instance) noexcept
+            : owner (instance), held (instance.enterProcessMutexForAudio()) {}
+        ~ScopedProcessLockUnlessCrashed() noexcept { if (held) owner.processMutex.exit(); }
+        bool isHeld() const noexcept { return held; }
+        ScopedProcessLockUnlessCrashed (const ScopedProcessLockUnlessCrashed&) = delete;
+        ScopedProcessLockUnlessCrashed& operator= (const ScopedProcessLockUnlessCrashed&) = delete;
+        VST3PluginInstanceHeadless& owner;
+        const bool held;
+    };
